# --- 本项目特定忽略 ---

# 模型权重文件（体积巨大，只保留目录占位符和下载链接）
models/**/*.safetensors
models/**/*.gguf
models/**/*.onnx
models/**/*.bin
models/**/*.npz
models/**/.cache/
models/*.py

# 模型分词器/配置文本（防止像 Qwen3-ASR-8bit 那样把 HF 克隆来的文件误提交进仓库）
models/**/*.json
models/**/merges.txt
models/**/tokenizer.model
models/**/*.tiktoken
models/**/.gitattributes
models/**/README.md

# 日志与按年归档的文件夹（如 2026/01/...）及其他四位数字年份目录
[0-9][0-9][0-9][0-9]/

# 日志文件夹（包含 server_*.log 和 client_*.log）
logs/

# 音频文件
*.mp3
*.wav
*.m4a

# 本地评测数据缓存：只提交 manifest / 下载说明 / 小型元数据，不提交公开数据集原始大文件
